// fake hashmap

#include <stdlib.h>
#include <assert.h>
#include <sys/types.h>

#include "types.h"

struct Elem {
	size_t hash;
	size_t val;
};

struct Elem* vec;
size_t size = 0;
size_t cap = 5000;

size_t hashfn(struct SearchSpace* key) {
	// fnv1
	size_t hash = 0xcbf29ce484222325;

	for (size_t i = 0; i < key->size; i++) {
		hash ^= key->idxs[i];
		hash *= 1099511628211;
	}

	return hash;
}

void map_init(void) {
	vec = malloc(cap * sizeof(struct Elem));
	assert(vec != NULL);
}

ssize_t map_get(struct SearchSpace* key) {
	size_t hash = hashfn(key);

	for (size_t i = 0; i < size; i++)
		if (vec[i].hash == hash)
			return vec[i].val;
	
	return -1;
}

void map_set(struct SearchSpace* key, size_t val) {
	if (key->size < 100) return;

	size_t hash = hashfn(key);

	for (size_t i = 0; i < size; i++)
		if (vec[i].hash == hash)
			return;
	
	if (size == cap) {
		cap *= 2;
		vec = realloc(vec, cap * sizeof(struct Elem));
	}

	vec[size].hash = hash;
	vec[size].val = val;
}
